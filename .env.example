# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / local)
# On Vercel, adding a Neon Postgres database from the Storage tab sets this for you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Public base URL of this deployment (used for short links, QR codes and the tracker snippet)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Supabase (used by the Library / saved reports feature)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: lock the dashboard behind HTTP Basic auth (short links + tracker stay public)
# DASHBOARD_USER="admin"
# DASHBOARD_PASSWORD="change-me"
